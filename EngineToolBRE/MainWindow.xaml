 <Window x:Class="EngineToolBRE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unity Template Tool" Height="380" Width="620" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    
    <TextBlock Text="Unity Version:" VerticalAlignment="Center" />
    <ComboBox Grid.Column="1" Margin="8,0"
              ItemsSource="{Binding UnityInstallations}"
              SelectedItem="{Binding SelectedUnity}"
              DisplayMemberPath="DisplayString" />
    <Button Grid.Column="2" Content="Neu scannen" Margin="8,0,0,0"
            Command="{Binding RescanCommand}" />

    
    <TextBlock Grid.Row="1" Text="Template:" VerticalAlignment="Center" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4"
              ItemsSource="{Binding Templates}"
              SelectedItem="{Binding SelectedTemplate}"
              DisplayMemberPath="Name" />

    
    <TextBlock Grid.Row="2" Text="Projektname:" VerticalAlignment="Center" />
    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,4"
             Text="{Binding ProjectName}" />

    
    <TextBlock Grid.Row="3" Text="Zielordner:" VerticalAlignment="Center" />
    <TextBox Grid.Row="3" Grid.Column="1" Margin="8,4"
             Text="{Binding TargetDirectory}" IsReadOnly="True" />
    <Button Grid.Row="3" Grid.Column="2" Content="Wählen…" Margin="8,4,0,4"
            Command="{Binding BrowseFolderCommand}" />

    
    <GroupBox Grid.Row="4" Grid.ColumnSpan="3" Header="Ausgabe" Margin="0,8,0,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
        <TextBox Text="{Binding LogText}" TextWrapping="Wrap"
                 IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
      </ScrollViewer>
    </GroupBox>

    
    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Erstellen" Width="120" Margin="0,0,8,0" Command="{Binding CreateCommand}" />
      <Button Content="Beenden" Width="100" Command="{Binding ExitCommand}" />
    </StackPanel>
  </Grid>
</Window>
